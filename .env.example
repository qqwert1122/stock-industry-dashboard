# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Decoding key from data.go.kr for Korea Customs open APIs.
DATA_GO_KR_SERVICE_KEY=

# Free API key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional SEC fair-access user agent. Include an email or contact URL if available.
SEC_USER_AGENT=

# Free key from https://api.data.gov/signup/ for NLR/NREL Alternative Fuel Stations.
NREL_API_KEY=

# Optional key from openFDA. The dashboard can run without it under lower rate limits.
OPENFDA_API_KEY=
